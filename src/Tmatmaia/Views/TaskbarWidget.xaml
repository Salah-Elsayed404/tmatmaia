<UserControl
    x:Class="Tmatmaia.Views.TaskbarWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="TimeArea" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0"
                    Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnTimeMouseDown">
            <TextBlock x:Name="TimeText" FontSize="30" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Text="25:00" />
            <TextBlock x:Name="PhaseText" FontSize="11" Opacity="0.7" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,4,0,0" Text="Focus #1" />
        </StackPanel>

        <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource GlyphButton}" Click="OnToggleClick" Content="▶" />
        <Button x:Name="ResetButton" Grid.Column="2" Style="{StaticResource GlyphButton}" Click="OnResetClick" Content="⟲" Margin="0,0,4,0" />

        <ProgressBar x:Name="Bar" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="3" Minimum="0" Maximum="1"
                     Background="Transparent" BorderThickness="0" Foreground="#E5484D" />
    </Grid>
</UserControl>
