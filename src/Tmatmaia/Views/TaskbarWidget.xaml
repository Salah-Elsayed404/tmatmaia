<UserControl
    x:Class="Tmatmaia.Views.TaskbarWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33808080" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Timer, phase and controls together in one rounded frame, with the progress bar along its bottom edge -->
    <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="10,1,2,1">
                <TextBlock x:Name="TimeText" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Text="25:00" />
                <TextBlock x:Name="PhaseText" FontSize="11" Opacity="0.7" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="8,4,6,0" Text="Focus #1" />
                <Button x:Name="ToggleButton" Style="{StaticResource GlyphButton}" Click="OnToggleClick" ToolTip="Start / pause" Content="&#xE768;" />
                <Button Style="{StaticResource GlyphButton}" Click="OnResetClick" ToolTip="Reset" Content="&#xE72C;" />
                <Button Style="{StaticResource GlyphButton}" Click="OnSettingsClick" ToolTip="Settings" Content="&#xE713;" />
            </StackPanel>

            <ProgressBar x:Name="Bar" VerticalAlignment="Bottom" Height="3" Margin="8,0,8,0" Minimum="0" Maximum="1"
                         Background="Transparent" BorderThickness="0" Foreground="#E5484D" />
        </Grid>
    </Border>
</UserControl>
